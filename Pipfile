[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
langgraph = ">=1.1.4,<2"
langchain = ">=1,<2"
langchain-openai = ">=1,<2"
langsmith = ">=0.4,<1"
pydantic = ">=2.12,<3"
playwright = ">=1.60,<2"
fastapi = ">=0.115,<1"
uvicorn = ">=0.34,<1"
pyyaml = ">=6,<7"
boto3 = ">=1.35,<2"
confluent-kafka = ">=2.12,<3"
psycopg = {extras = ["binary", "pool"], version = ">=3.2,<4"}

[dev-packages]
pytest = ">=8.4,<9"
httpx = ">=0.28,<1"

[requires]
python_version = "3.13"

[scripts]
test = "python -m pytest tests -q"
xhs-smoke = "python -m app.collectors.xiaohongshu_minimal --keyword 宠物 --sort latest --time-filter week --limit 3 --headless --output-dir outputs/collector-smoke"
